<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join Club</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="sign-up-container">
        <h1 class="heading">Join our club</h1>
        <p class="heading">Enter the passcode to gain membership privileges! </p>
        <form action="/join-club" method="POST">
            <label for="passcode">Passcode: </label>
            <input type="password" name="password" id="password">
            <button type="submit" class="log-in">Join the club</button>
        </form>

    </div>

    
</body>
</html>